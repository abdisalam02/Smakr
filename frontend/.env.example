# ---------------------------------------------------------------------------
# Smakr frontend environment (copy to `.env.local`)
# ---------------------------------------------------------------------------

# Backend API (FastAPI) — optional
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8001/ws

# Live vibe WebSocket stream — OPT-IN. Leave unset/false unless the FastAPI
# backend is actually running, otherwise the browser logs connection errors.
NEXT_PUBLIC_ENABLE_LIVE_VIBES=false

# MapLibre / MapTiler
NEXT_PUBLIC_MAPTILER_KEY=your_maptiler_key
NEXT_PUBLIC_MAPTILER_STYLE=https://api.maptiler.com/maps/streets-v2/style.json

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# SERVER-ONLY — never prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=your_secret_key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres

# Google Places (server-only). When absent, the admin importer runs in
# "curated beta mode" with high-res curated food photography.
GOOGLE_PLACES_API_KEY=
